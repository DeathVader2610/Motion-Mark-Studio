# Supabase: use the transaction-pooler URL for Vercel (copy it from Connect).
# No credentials = read-only public preview. Writes fail closed.
DATABASE_URL=
# Optional database root CA PEM (literal \n accepted); Vercel always verifies TLS.
DATABASE_SSL_CA=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Used for admin provisioning and portfolio uploads. Never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SITE_URL=http://localhost:3000
# A verified sender domain is required for production client confirmations.
RESEND_API_KEY=
EMAIL_FROM=Motion Mark Studio <hello@your-verified-domain.com>
# Cloudflare Turnstile: required for production enquiry submissions.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=
# Optional external media URLs are managed through Admin; don't put secrets in them.

# Server-only random secret for anonymous, opt-in visitor statistics.
ANALYTICS_SALT=
# Enable only after Google provider is configured in Supabase.
GOOGLE_LOGIN_ENABLED=false
